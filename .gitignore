# Dependencies
node_modules/

# Build artifacts
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.production
# Any production credential variant is ignored by default. The read-only census
# role lives in .env.production.readonly; a file holding a production credential
# must never be stageable (the shared-index hazard, CLAUDE.md 2.2). Fails safe:
# a NEW variant is ignored rather than exposed.
.env.production.*

# Uploads
uploads/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/

# Testing
coverage/
.nyc_output/

# Playwright E2E (Sprint 37)
playwright-report/
test-results/
/.playwright/

# Misc
.turbo/

# Local MCP connector config (references personal key path + sheet ID)
.mcp.json

# Frontend production env (contains API keys)
frontend/.env.production
my-knowledge-base/raw/assets/_extracted/
my-knowledge-base/raw/assets/*.zip

# Python bytecode cache
.claude/skills/**/__pycache__/
**/__pycache__/

# Audit-completeness reports (regenerated on each script run; tracked outside git)
docs/audit-reports/audit-*.md
docs/audit-reports/brand-conformance-*.md
.rehearsal-arc14/

# Drawer render-proof output — screenshots + measurements from e2e/render-proof.mjs.
# Kept local: the PNGs are for human eyes at review time and would be permanent
# binary churn in git. The measured geometry that constitutes the proof is
# transcribed into docs/audits/drawer-conformance-audit.md, where it is diffable.
e2e/render-proof-out/

# Operator-script before-images and undo files. These hold production customer
# rows (loads, shipments, contacts). Every such script's header says they are
# "NOT committed" and, until this pattern, nothing enforced it — they sat
# untracked, which §2.2 names as exactly the shape a broad `git add` sweeps into
# another session's commit. Same failure direction as the .env.production.*
# rule above: a NEW variant is ignored rather than exposed.
backend/scripts/_*-undo*.json
backend/scripts/_*-before.json

# `verify-bol-onepage.ts:18` writes this with a RELATIVE path, so `npm run
# verify:bol` — a gate on every commit touching the BOL — drops it in whatever
# directory it was run from, which is `backend/`. It is a rendered artifact, not
# a source file, and it regenerates on the next gate run. `out/` above already
# covers artifacts written where they belong; this one is written where it does
# not. Ignored rather than relocated because moving it means touching a gate
# script, and a gate is the wrong thing to change in passing.
backend/bol-out.pdf
